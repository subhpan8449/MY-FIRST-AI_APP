rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'subhpan8449@gmail.com' ||
        request.auth.token.role == 'admin'
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Public property & room imagery (public read, admin write)
    match /property/{allImages=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    match /rooms/{roomId}/{allImages=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    match /facilities/{allImages=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    match /rooftop/{allImages=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Private operational receipts (strictly admin)
    match /expenses/receipts/{receiptId} {
      allow read, write: if isAdmin() && isValidImage();
    }

    // User profile avatars
    match /users/{userId}/avatar {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }
  }
}
